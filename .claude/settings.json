{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File SPEC.MD/auto-commit-push/auto-commit-push.ps1"
          }
        ]
      }
    ]
  }
}
